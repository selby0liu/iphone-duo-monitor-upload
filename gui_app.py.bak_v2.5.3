class MainWindow(QMainWindow):
    # Cloud 状态信号（用于后台线程回调转到主线程）
    cloud_status_received = Signal(dict, bool, str)

    def __init__(self):
        super().__init__()
        self.setWindowTitle(f"iPhone Duo 库存监控 v{APP_VERSION}")
        self.setMinimumSize(1200, 800)

        self.monitor_thread = None
        self.monitor_worker = None
        self.current_status = {}
        self.api_history = APIHistory()
        self.consecutive_success = 0
        self.consecutive_failure = 0
        self.last_success_time = None
        self.last_error_time = None
        self.last_error_msg = ""
        self.test_mode = False
        self._check_count = 0
        self._current_msg_filter = "all"
        self._message_history = []

        if getattr(sys, 'frozen', False):
            self.config_dir = os.path.join(DATA_DIR, "config")
            os.makedirs(self.config_dir, exist_ok=True)
            import shutil
            # skus.json 和 stores.json 是程序数据，总是更新到最新版
            for fname in ["skus.json", "stores.json"]:
                src = os.path.join(APP_DIR, fname)
                dst = os.path.join(self.config_dir, fname)
                if os.path.exists(src):
                    shutil.copy2(src, dst)
            # config.json 是用户配置，只在不存在时复制
            for fname in ["config.json"]:
                src = os.path.join(APP_DIR, fname)
                dst = os.path.join(self.config_dir, fname)
                if os.path.exists(src) and not os.path.exists(dst):
                    shutil.copy2(src, dst)
        else:
            self.config_dir = BASE_DIR

        self.config, self.all_skus, self.stores = load_config(self.config_dir)
        self.store_map = get_store_map(self.stores)
        self.checkout = CheckoutAssistant(
            self.config.get("checkout", {}),
            bark_config=self.config.get("notification", {}).get("bark", {}),
        )

        # v2.0: Cloud 模式
        self.cloud_client = None
        self.cloud_mode = self.config.get("cloud", {}).get("enabled", True)
        self._cloud_last_inventory = {}  # 用于检测库存变化，触发本地通知

        # 消息通知栏持久化
        self._message_history_file = os.path.join(DATA_DIR, "message_history.json")
        self._load_message_history()

        # Cloud 状态信号连接（后台线程→主线程）
        self.cloud_status_received.connect(self._on_cloud_status_update)

        self._setup_ui()
        self._setup_tray()

        # v2.0: 根据模式启动
        if self.cloud_mode:
            QTimer.singleShot(500, self._start_cloud_mode)
        else:
            QTimer.singleShot(500, self.start_monitoring)

    def _create_status_card(self, title, value, color="#95a5a6"):
        """创建小型状态卡片"""
        card = QWidget()
        card.setStyleSheet(f"""
            QWidget {{
                background-color: #f5f6f7;
                border-radius: 6px;
                padding: 6px 10px;
            }}
        """)
        layout = QVBoxLayout(card)
        layout.setSpacing(2)
        layout.setContentsMargins(8, 6, 8, 6)

        title_label = QLabel(title)
        title_label.setFont(QFont("Menlo", 9))
        title_label.setStyleSheet("color: #888;")
        layout.addWidget(title_label)

        value_label = QLabel(value)
        value_label.setFont(QFont("Menlo", 12, QFont.Bold))
        value_label.setStyleSheet(f"color: {color};")
        value_label.setProperty("card_value", True)
        layout.addWidget(value_label)

        card.value_label = value_label
        return card

    def _update_card(self, card, value, color):
        """更新状态卡片的值和颜色"""
        if hasattr(card, 'value_label'):
            card.value_label.setText(value)
            card.value_label.setStyleSheet(f"color: {color};")

    def _on_sku_filter_changed(self, sku_id):
        """SKU 显示筛选变化时，更新表格列显示"""
        if not hasattr(self, 'store_table') or not hasattr(self, 'all_skus'):
            return
        # 使用预计算的列索引映射
        if not hasattr(self, '_sku_col_map'):
            return
        for sid, col_idx in self._sku_col_map.items():
            cb = self.sku_checkboxes.get(sid)
            if cb:
                self.store_table.setColumnHidden(col_idx, not cb.isChecked())

    def _set_msg_filter(self, filter_type):
        """设置消息筛选"""
        for btn in [self.msg_filter_all, self.msg_filter_pickup, self.msg_filter_delivery, self.msg_filter_available]:
            btn.setChecked(False)
        if filter_type == "all":
            self.msg_filter_all.setChecked(True)
        elif filter_type == "pickup":
            self.msg_filter_pickup.setChecked(True)
        elif filter_type == "delivery":
            self.msg_filter_delivery.setChecked(True)
        elif filter_type == "available":
            self.msg_filter_available.setChecked(True)
        self._current_msg_filter = filter_type
        self._refresh_message_list()

    def _load_message_history(self):
        """从文件加载消息历史"""
        try:
            if os.path.exists(self._message_history_file):
                with open(self._message_history_file, "r", encoding="utf-8") as f:
                    self._message_history = json.load(f)
        except Exception:
            self._message_history = []

    def _save_message_history(self):
        """保存消息历史到文件"""
        try:
            os.makedirs(os.path.dirname(self._message_history_file), exist_ok=True)
            with open(self._message_history_file, "w", encoding="utf-8") as f:
                json.dump(self._message_history[-200:], f, ensure_ascii=False)
        except Exception:
            pass

    def _add_inventory_message(self, time_str, product, location, inv_type, status, is_available=False):
        """添加库存事件消息"""
        if not hasattr(self, '_message_history'):
            self._message_history = []
        msg = {
            "time": time_str,
            "product": product,
            "location": location,
            "type": inv_type,  # pickup / delivery
            "status": status,
            "available": is_available
        }
        self._message_history.append(msg)
        # 保留最近200条
        if len(self._message_history) > 200:
            self._message_history = self._message_history[-200:]
        self._save_message_history()
        self._refresh_message_list()

    def _refresh_message_list(self):
        """刷新消息列表显示"""
        if not hasattr(self, 'message_list') or not hasattr(self, '_message_history'):
            return
        self.message_list.clear()
        msg_filter = getattr(self, '_current_msg_filter', 'all')
        for msg in reversed(self._message_history):
            if msg_filter == "pickup" and msg["type"] != "pickup":
                continue
            if msg_filter == "delivery" and msg["type"] != "delivery":
                continue
            if msg_filter == "available" and not msg["available"]:
                continue
            type_label = "门店现货" if msg["type"] == "pickup" else "邮寄库存"
            text = f"{msg['time']}  {msg['product']}  {msg['location']}  {type_label}  {msg['status']}"
            item = QListWidgetItem(text)
            if msg["available"]:
                item.setForeground(QColor("#27ae60"))
                item.setFont(QFont("Menlo", 10, QFont.Bold))
            elif "无货" in msg["status"] or "不可" in msg["status"]:
                item.setForeground(QColor("#7f8c8d"))
            else:
                item.setForeground(QColor("#f39c12"))
            self.message_list.addItem(item)

    def _setup_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setSpacing(10)
        main_layout.setContentsMargins(12, 12, 12, 12)

        # ===== 顶部：状态概览卡片 =====
        health_container = QWidget()
        health_layout = QHBoxLayout(health_container)
        health_layout.setSpacing(8)
        health_layout.setContentsMargins(0, 0, 0, 0)

        # Cloud 状态卡片
        self.cloud_card = self._create_status_card("Cloud", "检测中...", "#95a5a6")
        health_layout.addWidget(self.cloud_card)

        # Pickup 状态卡片
        self.pickup_card = self._create_status_card("门店库存", "检测中...", "#95a5a6")
        health_layout.addWidget(self.pickup_card)

        # 供货趋势状态卡片（替代原官网配送）
        self.trend_card = self._create_status_card("供货趋势", "检测中...", "#95a5a6")
        health_layout.addWidget(self.trend_card)

        # 最后更新卡片
        self.last_update_card = self._create_status_card("最后更新", "-", "#95a5a6")
        health_layout.addWidget(self.last_update_card)

        # 成功率卡片
        self.success_rate_card = self._create_status_card("1小时成功率", "-", "#95a5a6")
        health_layout.addWidget(self.success_rate_card)

        health_layout.addStretch()

        # 开发者署名（低调）
        self.developer_label = QLabel(DEVELOPER_NAME)
        self.developer_label.setFont(QFont("Menlo", 9))
        self.developer_label.setStyleSheet("color: #999;")
        self.developer_label.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
