        # 更新趋势标签（本地模式只显示当前状态，历史趋势需云端）
        self.trend_labels["current_stores"].setText(f"{current}/{total_stores}")
        self.trend_labels["restock_1h"].setText("-")
        self.trend_labels["restock_6h"].setText("-")
        self.trend_labels["restock_24h"].setText("-")
        self.trend_labels["last_restock"].setText("-")
        self.trend_labels["active_city"].setText("-")

        self.trend_pulse_label.setText("本地模式：完整供货趋势需云端运行")
        self.trend_events_label.setText("本地模式：补货历史需云端记录")

