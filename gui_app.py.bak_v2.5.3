    def start_monitoring(self):
        if self.monitor_thread and self.monitor_thread.isRunning():
            return
        # 本地模式下，Cloud 卡片显示未启用
        if not self.cloud_mode:
            self._update_card(self.cloud_card, "本地模式", "#3498db")
        self.monitor_thread = QThread()
        self.monitor_worker = MonitorWorker(self.config_dir)
        self.monitor_worker.moveToThread(self.monitor_thread)
        self.monitor_thread.started.connect(self.monitor_worker.start)
        self.monitor_worker.status_update.connect(self._on_status_update)
        self.monitor_worker.log_message.connect(self._on_log_message)
        self.monitor_worker.alert_signal.connect(self._on_alert)
        self.monitor_worker.api_record.connect(self._on_api_record)
        self.monitor_thread.start()
        self.status_bar.showMessage("监控运行中...")
        self._append_log("GUI 监控线程已启动")

    def stop_monitoring(self):
        if self.monitor_worker:
            self.monitor_worker.stop()
        if self.monitor_thread:
            self.monitor_thread.quit()
            self.monitor_thread.wait(10000)
            if self.monitor_thread.isRunning():
                self.monitor_thread.terminate()
                self.monitor_thread.wait(3000)
        self.monitor_worker = None
        self.monitor_thread = None
        self.status_bar.showMessage("监控已停止")
        self._append_log("监控已停止")

    # ===== v2.0: Cloud 模式 =====

    def _start_cloud_mode(self):
        """启动 Cloud 模式，从云端读取状态，不启动本地 Monitor"""
        from cloud_client import CloudClient

        server_url = self.cloud_url_edit.text().strip()
        auth_token = self.cloud_token_edit.text().strip()

        if not server_url or not auth_token:
            self._update_card(self.cloud_card, "未配置", "#e74c3c")
            self.status_bar.showMessage("Cloud 模式未配置，请在设置中填写服务器地址和 Token")
            # 回退到本地模式
            self.cloud_mode = False
            QTimer.singleShot(1000, self.start_monitoring)
            return

        backup_url = self.cloud_backup_url_edit.text().strip() if hasattr(self, "cloud_backup_url_edit") else ""
        if backup_url:
            from cloud_client import MultiCloudClient
            self.cloud_client = MultiCloudClient([server_url, backup_url], auth_token, poll_interval=10)
        else:
            self.cloud_client = CloudClient(server_url, auth_token, poll_interval=10)
        self._cloud_active_urls = (server_url, backup_url)
        # 回调在后台线程，通过信号转到主线程更新 GUI
        self.cloud_client.status_callback = lambda status, online, error: self.cloud_status_received.emit(status, online, error)
        self.cloud_client.start()

        self._update_card(self.cloud_card, "连接中...", "#f39c12")
        self.status_bar.showMessage("Cloud 模式运行中（本地 Monitor 已关闭）")
        self._append_log(f"Cloud 模式已启动: {server_url}" + (f" + 备用 {backup_url}" if backup_url else ""))

        # 更新顶部面板显示 Cloud 模式
        self._update_card(self.pickup_card, "等待数据...", "#f39c12")

    def _stop_cloud_mode(self):
        """停止 Cloud 模式"""
        if self.cloud_client:
            self.cloud_client.stop()
            self.cloud_client = None
        self._update_card(self.cloud_card, "已停止", "#95a5a6")

    def _on_cloud_status_update(self, status_data, online, error):
        """Cloud 状态更新回调"""
        if online and status_data:
            active_label = status_data.get("cloud_active_label")
            if active_label:
                degraded = "异常" in active_label
                self._update_card(self.cloud_card, f"在线 ✓ {active_label}", "#f39c12" if degraded else "#27ae60")
            else:
                self._update_card(self.cloud_card, "在线 ✓", "#27ae60")

            # 更新顶部状态卡片
            monitor = status_data.get("monitor", {})
            pickup = status_data.get("pickup", {})
            delivery = status_data.get("delivery", {})

            # Pickup 状态
            pickup_available = pickup.get("api_available")
            if pickup_available:
                self._update_card(self.pickup_card, "正常", "#27ae60")
            else:
                self._update_card(self.pickup_card, "异常", "#e74c3c")

            # 供货趋势状态（从 trends 数据判断）
            trends = status_data.get("trends", {})
            if trends and "error" not in trends:
                overview = trends.get("overview", {})
                current_stores = overview.get("current_available_stores", 0)
                total_stores = overview.get("total_stores", 0)
                restocks_24h = overview.get("restocks_24h", 0)
                self._update_card(self.trend_card, f"{current_stores}/{total_stores}店", "#27ae60" if current_stores > 0 else "#95a5a6")
            else:
                self._update_card(self.trend_card, "趋势数据加载中", "#95a5a6")

            # 最后更新时间
            if monitor.get("last_check"):
                from datetime import datetime as dt
                last_time = dt.fromtimestamp(monitor['last_check']).strftime('%H:%M:%S')
                self._update_card(self.last_update_card, last_time, "#2c3e50")

            # 成功率
            api_stats = status_data.get("api_stats", {})
            if api_stats:
                success_rate = api_stats.get("success_rate", 0)
                self._update_card(self.success_rate_card, f"{success_rate:.0f}%", "#27ae60" if success_rate > 80 else "#f39c12")

            # 次级技术信息
            check_count = monitor.get("check_count", 0)
            self._check_count = check_count
            self.tech_info_label.setText(
                f"IP: {status_data.get('public_ip', '-')} | "
                f"ISP: {status_data.get('isp', '-')} | "
                f"HTTP: {pickup.get('last_http_status', pickup.get('last_http', '-'))} | "
                f"累计检查: {check_count} | "
                f"连续成功: {pickup.get('consecutive_success', 0)} | "
                f"连续失败: {pickup.get('consecutive_failures', 0)}"
            )

            # 更新供货趋势（从云端 trends 数据）
            self._update_trends_from_cloud(status_data)

            # 更新对照组页面（从云端数据读取）
            self._update_china_control(status_data)
            self._update_australia_control(status_data)

            # 检测库存变化并触发本地通知
            inventory = status_data.get("inventory", {})
            self._detect_cloud_inventory_changes(inventory)

            # 更新库存表
            self._update_store_table_from_cloud(inventory)

        else:
            self._update_card(self.cloud_card, "离线", "#e74c3c")
            self._update_card(self.pickup_card, "云端离线", "#e74c3c")
            # 不显示无货，保持最后已知状态

    def _update_trends_from_cloud(self, status_data):
        """从云端数据更新供货趋势显示"""
        from datetime import datetime as dt
        trends = status_data.get("trends", {})

        if not trends or "error" in trends:
            for key in self.trend_labels:
                self.trend_labels[key].setText("-")
            self.trend_pulse_label.setText("趋势数据暂不可用")
            self.trend_events_label.setText("趋势数据暂不可用")
            return

        # 概览指标
        overview = trends.get("overview", {})
        current_stores = overview.get("current_available_stores", 0)
        total_stores = overview.get("total_stores", 0)
        self.trend_labels["current_stores"].setText(f"{current_stores}/{total_stores}")
        self.trend_labels["restock_1h"].setText(str(overview.get("restocks_1h", 0)))
        self.trend_labels["restock_6h"].setText(str(overview.get("restocks_6h", 0)))
        self.trend_labels["restock_24h"].setText(str(overview.get("restocks_24h", 0)))

        last_restock_time = overview.get("last_restock_time")
        if last_restock_time:
            self.trend_labels["last_restock"].setText(dt.fromtimestamp(last_restock_time).strftime('%H:%M'))
        else:
            self.trend_labels["last_restock"].setText("-")
        self.trend_labels["active_city"].setText(overview.get("most_active_city", "-"))

        # 补货脉冲
        pulse = trends.get("restock_pulse", {})
        pulse_text = f"最近30分钟补货: {pulse.get('restocks_30m', 0)}次"
        if pulse.get("is_active"):
            pulse_text += " ⚡补货活跃"
        by_city = pulse.get("by_city", {})
        if by_city:
            city_str = " | ".join(f"{c}:{n}" for c, n in sorted(by_city.items(), key=lambda x: -x[1])[:3])
            pulse_text += f"\n{city_str}"
        self.trend_pulse_label.setText(pulse_text)

        # 最近补货事件
        events = trends.get("recent_events", [])
        if events:
            event_lines = []
            for e in events[-8:]:
                time_str = dt.fromtimestamp(e["timestamp"]).strftime('%H:%M')
                sku_name = e.get("product_name", e.get("sku_id", ""))
                store_name = e.get("store_name", e.get("store_number", ""))
                if e.get("is_restock"):
                    event_lines.append(f"{time_str} {store_name}｜{sku_name}｜补货")
                elif e.get("is_sold_out"):
                    event_lines.append(f"{time_str} {store_name}｜{sku_name}｜售罄")
            self.trend_events_label.setText("\n".join(event_lines) if event_lines else "暂无事件")
        else:
            self.trend_events_label.setText("暂无补货事件")

    def _detect_cloud_inventory_changes(self, inventory):
        """检测云端库存变化，触发 macOS 本地通知、声音和消息栏"""
        if not inventory:
            return

        from datetime import datetime as dt
        time_str = dt.now().strftime('%H:%M:%S')

        # Checkout Assistant：App 启动后第一次收到非空 snapshot 只建立 baseline，不打开页面
        checkout_initial_snapshot = not self._cloud_last_inventory
        checkout_hits = []

        # inventory 格式: {"sku_id|store_number": {"available": True/False/None, ...}}
        for key, state in inventory.items():
            if "|" not in key:
                continue
            available = state.get("available")
            prev = self._cloud_last_inventory.get(key, {}).get("available")

            # 解析 SKU 和门店
            parts = key.split("|", 1)
            sku_id = parts[0]
            store_number = parts[1]

            # 获取 SKU 名称
            sku_name = sku_id
            sku_info = {}
            for sku in self.all_skus:
                if sku.get("id") == sku_id or sku.get("part_number") == sku_id:
                    sku_info = sku
                    sku_name = f"{sku.get('capacity','')} {sku.get('color','')}"
                    break

            # 获取门店名称和城市
            store_name = store_number
            city = ""
            for region_name, region_data in self.stores.get("regions", {}).items():
                for s in region_data.get("stores", []):
                    if s.get("store_number") == store_number:
                        store_name = s.get("name", s.get("store_name", store_number))
                        city = s.get("city", region_name)
                        break
                if store_name != store_number:
                    break

            location = f"{city} {store_name}" if city else store_name

            # 状态变化检测
            if available is True and prev is not True:
                # 从无货/未知变为有货
                self._add_inventory_message(time_str, sku_name, location, "pickup", "有货 ✓", is_available=True)

                # 触发 macOS 通知
                title = "iPhone 有货！"
                body = f"{sku_name}\n门店: {store_name}\n点击查看详情"
                self._send_macos_notification(title, body)

                # 播放声音
                if self.config.get("notification", {}).get("sound", True):
                    self._play_alert_sound()

                # 自动打开购买页（旧开关）。Checkout Assistant 启用时由其统一去重打开，避免双开
                if self.config.get("notification", {}).get("auto_open_buy_page", False) and not self.checkout.enabled:
                    self._open_buy_page(sku_id)

                self._append_log(f"[Cloud通知] {sku_name} @ {store_name} 有货！")

                if self.checkout.enabled:
                    checkout_hits.append({
                        "sku_id": sku_id,
                        "part_number": sku_info.get("part_number", sku_id),
                        "sku_name": sku_info.get("name", sku_name),
                        "capacity": sku_info.get("capacity", ""),
                        "color": sku_info.get("color", ""),
                        "store_number": store_number,
                        "store_name": store_name,
                        "city": city,
                    })

            elif available is False and prev is True:
                # 从有货变为无货
                self._add_inventory_message(time_str, sku_name, location, "pickup", "无货", is_available=False)

        # 更新上次状态
        self._cloud_last_inventory = inventory

        if checkout_hits:
            self._run_checkout_assistant(checkout_hits, initial_snapshot=checkout_initial_snapshot)

    def _run_checkout_assistant(self, hits, initial_snapshot=False):
        """Mac 本地外围层：把本轮命中交给 Checkout Assistant，结果只写日志和消息栏，不发额外系统通知"""
        try:
            results = self.checkout.on_stock_wave(hits, initial_snapshot=initial_snapshot)
        except Exception as e:
            self._append_log(f"[Checkout] 异常（不影响监控）: {e}")
            return
        time_str = datetime.now().strftime('%H:%M:%S')
        for r in results:
            self._append_log(f"[Checkout] {r['message']}{'｜已推送手机' if r.get('pushed') else ''}")
            if r.get("opened"):
                self._add_inventory_message(time_str, r["product_label"], r["stores_label"],
                                            "pickup", "已打开购买页", is_available=True)
        self._update_checkout_state()

    def _send_macos_notification(self, title, body):
        """发送 macOS 系统通知"""
        try:
            import subprocess
            script = f'display notification "{body}" with title "{title}" sound name "Glass"'
            subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
        except Exception as e:
            self._append_log(f"[通知失败] {e}")

    def _play_alert_sound(self):
        """播放提示音"""
        try:
            import subprocess
            sound_file = self.config.get("notification", {}).get("sound_file", "/System/Library/Sounds/Glass.aiff")
            subprocess.run(["afplay", sound_file], capture_output=True, timeout=5)
        except Exception:
            pass

    def _open_buy_page(self, sku_id):
        """打开 Apple 官方购买页"""
        try:
            from PySide6.QtGui import QDesktopServices
            from PySide6.QtCore import QUrl
            # 构建 Apple 购买页 URL
            part_number = sku_id
            for sku in self.all_skus:
                if sku.get("id") == sku_id:
                    part_number = sku.get("part_number", sku_id)
                    break
            url = self.checkout.get_buy_url(part_number)
            QDesktopServices.openUrl(QUrl(url))
        except Exception as e:
            self._append_log(f"[打开购买页失败] {e}")

    def _update_store_table_from_cloud(self, inventory):
        """从云端库存数据更新表格"""
        if not inventory:
            return
        try:
            # 获取启用的 SKU 列表（用于列映射）
            enabled_skus = get_enabled_skus(self.all_skus)

            for row in range(self.store_table.rowCount()):
                # Store ID 在第3列（index 2）
                store_id_item = self.store_table.item(row, 2)
                if not store_id_item:
                    continue
                store_number = store_id_item.text()

                for col, sku in enumerate(enabled_skus):
                    if col + 3 >= self.store_table.columnCount():
                        break
                    sku_id = sku.get("id", sku.get("part_number", ""))
                    key = f"{sku_id}|{store_number}"
                    state = inventory.get(key, {})
                    available = state.get("available")

                    if available is True:
                        text = "有货"
                        color = QColor("#f39c12")  # 橙色
                    elif available is False:
                        text = "无货"
                        color = None  # 无颜色
                    else:
                        text = "-"
                        color = None  # 无颜色

                    item = QTableWidgetItem(text)
                    if color:
                        item.setForeground(color)
                    item.setTextAlignment(Qt.AlignCenter)
                    self.store_table.setItem(row, col + 3, item)
        except Exception as e:
            self._append_log(f"[Cloud表格更新失败] {e}")

    def _test_cloud_connection(self):
        """测试 Cloud 连接"""
        from cloud_client import CloudClient

        server_url = self.cloud_url_edit.text().strip()
        auth_token = self.cloud_token_edit.text().strip()

        if not server_url or not auth_token:
            QMessageBox.warning(self, "提示", "请先填写服务器地址和 Token")
            return

        self.cloud_test_btn.setEnabled(False)
        self.cloud_test_btn.setText("测试中...")
        backup_url = self.cloud_backup_url_edit.text().strip() if hasattr(self, "cloud_backup_url_edit") else ""

        def do_test():
            if backup_url:
                from cloud_client import MultiCloudClient
                client = MultiCloudClient([server_url, backup_url], auth_token)
            else:
                client = CloudClient(server_url, auth_token)
            success, msg = client.test_connection()
            self.cloud_test_btn.setEnabled(True)
            self.cloud_test_btn.setText("测试 Cloud 连接")
            if success:
                self.cloud_status_label.setText(f"Cloud 状态: {msg}")
                self.cloud_status_label.setStyleSheet("color: #27ae60;")
                QMessageBox.information(self, "连接成功", msg)
            else:
                self.cloud_status_label.setText(f"Cloud 状态: 连接失败 - {msg[:50]}")
                self.cloud_status_label.setStyleSheet("color: #e74c3c;")
                QMessageBox.warning(self, "连接失败", msg)

        from threading import Thread
        Thread(target=do_test, daemon=True).start()

    def _toggle_cloud_token_visibility(self, checked):
        """切换 Cloud Token 显示/隐藏"""
        if checked:
            self.cloud_token_edit.setEchoMode(QLineEdit.Normal)
            self.cloud_token_toggle_btn.setText("隐藏")
        else:
            self.cloud_token_edit.setEchoMode(QLineEdit.Password)
            self.cloud_token_toggle_btn.setText("显示")

    def _on_api_record(self, endpoint, http_status, latency, success, network_session_id=0):
        self.api_history.current_session_id = network_session_id
        self.api_history.record(endpoint, http_status, latency, success, network_session_id)
        if success:
            self.consecutive_success += 1
            self.consecutive_failure = 0
            self.last_success_time = time.time()
        else:
            self.consecutive_failure += 1
            self.consecutive_success = 0
            self.last_error_time = time.time()
            self.last_error_msg = f"HTTP {http_status}"

    def _on_status_update(self, status_data):
        self.current_status = status_data

        pickup_api = status_data.get("pickup_api_available")
        if pickup_api is True:
            self._update_card(self.pickup_card, "正常", "#27ae60")
        elif pickup_api is False:
            self._update_card(self.pickup_card, "异常", "#e74c3c")
        else:
            self._update_card(self.pickup_card, "检测中...", "#f39c12")

        meta = status_data.get("meta", {})
        last_check = meta.get("last_check")
        if last_check:
            self._update_card(self.last_update_card, datetime.fromtimestamp(last_check).strftime('%H:%M:%S'), "#2c3e50")

        # 成功率
        stats = self.api_history.get_stats(hours=1)
        if stats and stats.get('total', 0) > 0:
            rate = stats.get('success_rate', 0) * 100
            self._update_card(self.success_rate_card, f"{rate:.0f}%", "#27ae60" if rate > 80 else "#f39c12")

        # 次级技术信息
        region_interval = status_data.get('pickup_region_interval', 15)
        stagger = status_data.get('pickup_stagger', 5)
        backoff_dict = status_data.get('pickup_backoff', {})
        max_backoff = max(backoff_dict.values()) if backoff_dict else 0
        backoff_text = f" | 退避: {max_backoff}秒" if max_backoff > 0 else ""
        self.tech_info_label.setText(
            f"区域轮询: {region_interval}秒 | 错峰: {stagger}秒{backoff_text} | "
            f"累计检查: {meta.get('check_count', 0)} | "
            f"连续成功: {self.consecutive_success} | 连续失败: {self.consecutive_failure}"
        )

        self._update_network_info()
        self._update_store_table(status_data)
        self._update_trends_local(status_data)
        self._update_stats_panel()
        self._update_china_control(status_data)
        self._update_australia_control(status_data)
        self._update_market_watch(status_data)

    def _update_network_info(self):
        """更新网络信息（带30秒缓存，避免每秒查询阻塞GUI）"""
        now = time.time()
        if hasattr(self, '_last_network_check') and now - self._last_network_check < 30:
            return
        self._last_network_check = now
        try:
            import urllib.request
            ip = urllib.request.urlopen("https://api.ipify.org", timeout=3).read().decode()
            # 查询 ISP（失败不影响监控）
            isp = "未知"
            try:
                import json
                req = urllib.request.Request(
                    f"http://ip-api.com/json/{ip}?fields=isp,org",
                    headers={"User-Agent": "iPhoneDuoMonitor/2.1"})
                resp = urllib.request.urlopen(req, timeout=3)
                data = json.loads(resp.read().decode())
                isp = data.get("isp", "未知")
            except:
                pass
            # 更新次级技术信息（追加到现有内容）
            current = self.tech_info_label.text()
            if "IP:" in current:
                # 替换 IP 部分
                import re
                current = re.sub(r'IP: [^|]+', f'IP: {ip}', current)
                current = re.sub(r'ISP: [^|]+', f'ISP: {isp}', current)
                self.tech_info_label.setText(current)
        except:
            pass

    def _update_store_table(self, status_data):
        pickup_status = status_data.get("pickup_status", {})
        enabled_skus = status_data.get("enabled_skus", [])
        pickup_api_ok = status_data.get("pickup_api_available")

        for row in range(self.store_table.rowCount()):
            store_id_item = self.store_table.item(row, 2)
            if not store_id_item:
                continue
            store_number = store_id_item.text()
            store_data = pickup_status.get(store_number, {})

            last_known_text = "无数据"
            for col, sku in enumerate(enabled_skus):
                sku_data = store_data.get("skus", {}).get(sku["id"], {})
                available = sku_data.get("available")
                item = QTableWidgetItem()

                if pickup_api_ok is False:
                    # API 不可用，显示未知（短横杠），无颜色
                    item.setText("-")
                    last_known = sku_data.get("last_known")
                    if last_known is True:
                        last_known_text = "最后已知: 有货"
                    elif last_known is False:
                        last_known_text = "最后已知: 无货"
                elif available is True:
                    item.setText("有货")
                    item.setForeground(QColor("#f39c12"))  # 橙色
                    last_known_text = "有货"
                elif available is False:
                    item.setText("无货")
                    last_known_text = "无货"
                else:
                    item.setText("-")

                item.setTextAlignment(Qt.AlignCenter)
                self.store_table.setItem(row, 3 + col, item)

            # 最后已知状态列
            self.store_table.setItem(row, 3 + len(enabled_skus), QTableWidgetItem(last_known_text))

            # 更新时间
            last_checked = None
            for sku in enabled_skus:
                sku_data = store_data.get("skus", {}).get(sku["id"], {})
                if sku_data.get("last_checked"):
                    last_checked = sku_data["last_checked"]
                    break
            if last_checked:
                time_str = datetime.fromtimestamp(last_checked).strftime("%H:%M:%S")
                self.store_table.setItem(row, 4 + len(enabled_skus), QTableWidgetItem(time_str))

    def _update_trends_local(self, status_data):
