    def _add_market_sample(self):
        """手动添加二级市场报价"""
        sku_names = ["duo_512_starlight", "duo_512_midnight", "duo_1tb_starlight", "duo_1tb_midnight"]
        sku_idx = self.mw_sku_combo.currentIndex()
        sku_id = sku_names[sku_idx]
        try:
            price = float(self.mw_price_input.text())
        except ValueError:
            self._append_log("Market Watch: 价格格式错误")
            return

        if hasattr(self, 'monitor_worker') and self.monitor_worker and hasattr(self.monitor_worker, 'market_watch'):
            success = self.monitor_worker.market_watch.add_manual_sample(sku_id, price)
            if success:
                self._append_log(f"Market Watch: 已添加 {sku_id} ¥{price}")
                self.mw_price_input.clear()
            else:
                self._append_log(f"Market Watch: 价格无效（¥{price}），已拒绝")
        else:
            self._append_log("Market Watch: 监控未启动，无法添加")

    def _on_log_message(self, msg):
        self._append_log(msg)

    def _append_log(self, msg):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.log_text.append(f"[{timestamp}] {msg}")
        if self.log_text.document().blockCount() > 500:
            cursor = self.log_text.textCursor()
            cursor.movePosition(cursor.Start)
            cursor.select(cursor.LineUnderCursor)
            cursor.removeSelectedText()
            cursor.deleteChar()

    def _on_alert(self, alerts):
        checkout_hits = []
        for alert in alerts:
            if alert["type"] == "pickup":
                sku_id = alert["sku_id"]
                store_number = alert["store_number"]
                detail = alert.get("detail", {})
                sku_info = next((s for s in self.all_skus if s["id"] == sku_id), {})
                msg = f"有货! {sku_info.get('capacity', '')} {sku_info.get('color', '')} @ {detail.get('store_name', store_number)}"
                self._append_log(f"*** 报警: {msg} ***")
                self.tray_icon.showMessage(
                    "iPhone Duo 有货!",
                    f"{sku_info.get('capacity', '')} {sku_info.get('color', '')}\n{detail.get('store_name', store_number)}\n{detail.get('pickup_search_quote', '')}",
                    QSystemTrayIcon.Information, 10000)
                # 触发 Checkout Assistant（如果启用；本轮所有报警合并为一个 wave）
                if self.checkout.enabled:
                    checkout_hits.append({
                        "sku_id": sku_id,
                        "part_number": sku_info.get("part_number", ""),
                        "sku_name": sku_info.get("name", ""),
                        "capacity": sku_info.get("capacity", ""),
                        "color": sku_info.get("color", ""),
                        "store_number": store_number,
                        "store_name": detail.get("store_name", store_number),
                        "city": detail.get("city", ""),
                    })
            elif alert["type"] == "delivery":
                sku_id = alert["sku_id"]
                detail = alert.get("detail", {})
                sku_info = next((s for s in self.all_skus if s["id"] == sku_id), {})
                self._append_log(f"*** 报警: 配送有货! {sku_info.get('capacity', '')} {sku_info.get('color', '')} ***")
                if self.checkout.enabled:
                    checkout_hits.append({
                        "sku_id": sku_id,
                        "part_number": sku_info.get("part_number", ""),
                        "sku_name": sku_info.get("name", ""),
                        "capacity": sku_info.get("capacity", ""),
                        "color": sku_info.get("color", ""),
                        "store_number": "",
                        "store_name": "官网配送",
                        "city": "",
                    })
        if checkout_hits:
            self._run_checkout_assistant(checkout_hits)

    def _on_interval_changed(self, value):
        if self.monitor_worker:
            self.monitor_worker.update_interval(value)
        self._append_log(f"轮询间隔已更新为 {value} 秒")

    def _toggle_test_mode(self, state):
        self.test_mode = (state == Qt.Checked.value)
        self.test_mode_banner.setVisible(self.test_mode)
        self.trigger_test_btn.setEnabled(self.test_mode)
        if self.monitor_worker:
            self.monitor_worker.test_mode = self.test_mode
        self._append_log(f"Test Mode: {'已启用' if self.test_mode else '已关闭'}")

    def _trigger_test_alert(self):
        if self.monitor_worker:
            self.monitor_worker.trigger_test_alert()

    def _test_pickup_api(self):
        self._append_log("手动测试 Pickup API...")
        QTimer.singleShot(100, lambda: self._run_api_test("pickup"))

    def _test_delivery_api(self):
        self._append_log("手动测试 Delivery API...")
        QTimer.singleShot(100, lambda: self._run_api_test("delivery"))

    def _run_api_test(self, api_type):
        try:
            from apple_api import AppleCNAPI
            api = AppleCNAPI(self.config)
            if api_type == "pickup":
                stores, _ = api.check_pickup_availability(["MK2P4CH/A"], "200000")
                self._append_log(f"Pickup API 测试成功，返回 {len(stores)} 家门店")
            else:
                result = api.check_delivery_availability(["MK2P4CH/A"], "200000")
                self._append_log(f"Delivery API 测试成功")
        except Exception as e:
            self._append_log(f"API 测试失败: {e}")

    def _test_macos_notification(self):
        self.tray_icon.showMessage("测试通知", "这是一条测试通知，macOS 通知功能正常。",
                                   QSystemTrayIcon.Information, 3000)
        self._append_log("已发送测试 macOS 通知")

    def _test_sound(self):
        try:
            subprocess.run(["afplay", "/System/Library/Sounds/Glass.aiff"], timeout=5)
            self._append_log("已播放测试声音")
        except Exception as e:
            self._append_log(f"播放声音失败: {e}")

    def _toggle_bark_visibility(self, checked):
        """切换 Bark Key 显示/隐藏"""
        if checked:
            self.bark_key_edit.setEchoMode(QLineEdit.Normal)
            self.bark_toggle_btn.setText("隐藏")
        else:
            self.bark_key_edit.setEchoMode(QLineEdit.Password)
            self.bark_toggle_btn.setText("显示")

    def _test_bark(self):
        bark_url = self.bark_key_edit.text().strip()
        if not bark_url:
            self._append_log("Bark Key 未配置")
            return
        try:
            import urllib.request
            url = f"{bark_url}/测试通知/iPhone Duo 库存监控测试"
            urllib.request.urlopen(url, timeout=5)
            self._append_log("Bark 测试推送已发送")
        except Exception as e:
            self._append_log(f"Bark 测试失败: {e}")

    def _open_log_dir(self):
        log_dir = os.path.join(DATA_DIR, "logs")
        os.makedirs(log_dir, exist_ok=True)
        subprocess.run(["open", log_dir])

    def _refresh_diagnostics(self):
        """刷新 Diagnostics 标签页数据（v1.5.0）"""
        try:
            if not hasattr(self.worker, 'diagnostics') or not self.worker.diagnostics:
                return
            data = self.worker.diagnostics.get_dashboard_data()

            # 更新会话信息
            session = data.get("session", {})
            self.diag_session_label.setText(
                f"Session: {session.get('session_id', '-')} | "
                f"IP: {session.get('public_ip', '-')} | "
                f"ISP: {session.get('isp', '-')}"
            )

            # 更新对比表格
            modules = [
                data.get("app_stats", {}),
                data.get("sentinel_a", {}),
                data.get("sentinel_b", {}),
            ]
            for row, stats in enumerate(modules):
                if stats:
                    self.diag_compare_table.setItem(row, 1, QTableWidgetItem(str(stats.get("total", 0))))
                    self.diag_compare_table.setItem(row, 2, QTableWidgetItem(str(stats.get("stats", {}).get("200", 0))))
                    self.diag_compare_table.setItem(row, 3, QTableWidgetItem(str(stats.get("stats", {}).get("541", 0))))
                    self.diag_compare_table.setItem(row, 4, QTableWidgetItem(f"{stats.get('success_rate', 0)}%"))
                    self.diag_compare_table.setItem(row, 5, QTableWidgetItem(str(stats.get("consecutive_541", 0))))

            # 更新 DIVERGENCE EVENTS
            events = data.get("divergence_events", [])
            if events:
                event_text = "\n".join([
                    f"[{e.get('timestamp', '')}] {e.get('type', '')}: "
                    f"App={e.get('app_status', '')}, "
                    f"SA={e.get('sentinel_a_status', '')}, "
                    f"SB={e.get('sentinel_b_status', '')}"
                    for e in events
                ])
                self.diag_divergence_text.setText(event_text)
            else:
                self.diag_divergence_text.setText("暂无分叉事件")

        except Exception as e:
            self.diag_divergence_text.setText(f"刷新失败: {e}")

    def _generate_diag_summary(self):
        """生成晨间摘要（v1.5.0）"""
        try:
            if not hasattr(self.worker, 'diagnostics') or not self.worker.diagnostics:
                QMessageBox.warning(self, "提示", "诊断模块未启动")
                return
            summary = self.worker.diagnostics.generate_morning_summary()
            self.diag_divergence_text.setText(summary)
            QMessageBox.information(self, "晨间摘要", "摘要已生成并写入 diagnostics_summary.log")
        except Exception as e:
            QMessageBox.warning(self, "错误", f"生成摘要失败: {e}")

    def _export_diagnostic_report(self):
        report = f"""=== iPhone Duo 库存监控 诊断报告 ===
生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
软件版本: {APP_VERSION}
开发者: {DEVELOPER_NAME}

=== 系统信息 ===
macOS: {platform.mac_ver()[0]}
架构: {platform.machine()}
Python: {platform.python_version()}

=== 网络信息 ===
公网 IP: {self.tech_info_label.text().split('IP:')[1].split('|')[0].strip() if 'IP:' in self.tech_info_label.text() else '-'}
网络状态: {self.cloud_card.value_label.text() if hasattr(self, 'cloud_card') else '-'}

=== API 状态 ===
Pickup API: {self.pickup_card.value_label.text() if hasattr(self, 'pickup_card') else '-'}
供货趋势: {self.trend_card.value_label.text() if hasattr(self, 'trend_card') else '-'}
连续成功: {self.consecutive_success}
连续失败: {self.consecutive_failure}
累计检查: {getattr(self, '_check_count', 0)}

=== API 统计（最近1小时）===
{json.dumps(self.api_history.get_stats(hours=1), indent=2)}

=== SKU 配置 ===
"""
        for sku in self.all_skus:
            report += f"  {sku['part_number']}: {sku['name']} (enabled={sku.get('enabled')})\n"

        report += "\n=== 门店配置 ===\n"
        for sn in get_all_store_numbers(self.stores):
            info = self.store_map.get(sn, {})
            report += f"  {sn}: {info.get('name', '')} ({info.get('city', '')})\n"

        report += f"\n=== 最近错误 ===\n{self.last_error_msg or '无'}\n"
        report += "\n注意: 本报告不包含 Bark Key、Apple ID、Cookie、Token、地址、电话等敏感信息。\n"

        file_path, _ = QFileDialog.getSaveFileName(self, "导出诊断报告",
                                                    f"diagnostic_report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt",
                                                    "Text Files (*.txt)")
        if file_path:
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(report)
            self._append_log(f"诊断报告已导出: {file_path}")

    def _toggle_checkout(self, state):
        self.checkout.enabled = (state == Qt.Checked.value)
        self._append_log(f"Checkout Assistant: {'已启用' if self.checkout.enabled else '已关闭'}")
        self._update_checkout_state()
        self._persist_checkout_config()

    def _on_checkout_option_changed(self, _state=None):
        self.checkout.auto_open_page = self.checkout_auto_open_cb.isChecked()
        self.checkout.auto_add_to_cart = self.checkout_auto_cart_cb.isChecked()
        self.checkout.auto_fill_details = self.checkout_auto_fill_cb.isChecked()
        self.checkout.auto_start_checkout = self.checkout_auto_checkout_cb.isChecked()
        self._persist_checkout_config()

    def _on_checkout_browser_changed(self, _index=None):
        self.checkout.browser = self.checkout_browser_combo.currentData() or "default"
        self._append_log(f"Checkout Assistant: 打开方式 = {self.checkout.browser}")
        self._persist_checkout_config()

    def _persist_checkout_config(self):
        """把 Checkout 开关写入 config.json 的 checkout 段（仅本机配置；首次安装默认 enabled=false）"""
        config_path = os.path.join(self.config_dir, "config.json")
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
            config["checkout"] = self.checkout.to_config()
            with open(config_path, "w", encoding="utf-8") as f:
                json.dump(config, f, ensure_ascii=False, indent=2)
            self.config["checkout"] = config["checkout"]
        except Exception as e:
            self._append_log(f"[Checkout] 保存配置失败: {e}")

    def _update_checkout_state(self):
        info = self.checkout.get_state_info()
        self.checkout_state_label.setText(f"状态: {info['state']}")
        self.checkout_sku_label.setText(f"当前 SKU: {info.get('current_sku') or '-'}")
        self.checkout_store_label.setText(f"当前门店: {info.get('current_store') or '-'}")

    def _save_checkout_profile(self):
        profile = {
            "name": self.profile_name_edit.text().strip(),
            "phone": self.profile_phone_edit.text().strip(),
            "address": self.profile_address_edit.text().strip(),
        }
        self.checkout.save_profile(profile)
        self._append_log("收货资料已保存（仅本机，已过滤敏感字段）")

    def _clear_checkout_profile(self):
        self.checkout.clear_profile()
        self.profile_name_edit.clear()
        self.profile_phone_edit.clear()
        self.profile_address_edit.clear()
        self._append_log("收货资料已清除")

    def _save_settings(self):
        config_path = os.path.join(self.config_dir, "config.json")
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                config = json.load(f)
            config["monitor"]["interval_seconds"] = self.interval_spin.value()
            config["notification"]["macos_notification"] = self.macos_notify_cb.isChecked()
            config["notification"]["sound"] = self.sound_cb.isChecked()
            config["notification"]["auto_open_buy_page"] = self.auto_open_cb.isChecked()
            config["notification"]["bark"]["enabled"] = self.bark_enabled_cb.isChecked()
            config["notification"]["bark"]["url"] = self.bark_key_edit.text()
            config["checkout"] = self.checkout.to_config()
            self.checkout.set_bark_config(config["notification"]["bark"])
            # v2.0: Cloud 配置
            if "cloud" not in config:
                config["cloud"] = {}
            new_cloud_enabled = self.cloud_enabled_cb.isChecked()
            config["cloud"]["enabled"] = new_cloud_enabled
            config["cloud"]["server_url"] = self.cloud_url_edit.text()
            config["cloud"]["backup_server_url"] = self.cloud_backup_url_edit.text().strip()
            config["cloud"]["auth_token"] = self.cloud_token_edit.text()
            with open(config_path, "w", encoding="utf-8") as f:
                json.dump(config, f, ensure_ascii=False, indent=2)
            self._append_log("设置已保存")

            new_urls = (self.cloud_url_edit.text().strip(), self.cloud_backup_url_edit.text().strip())
            if new_cloud_enabled == self.cloud_mode and new_cloud_enabled and self.cloud_client \
                    and new_urls != getattr(self, "_cloud_active_urls", None):
                # 地址变化：按新的主/备地址重新连接
                self._stop_cloud_mode()
                self._cloud_last_inventory = {}
                self._start_cloud_mode()
                QMessageBox.information(self, "设置已保存", "已按新的服务器地址重新连接 Cloud。")
            # 如果 Cloud 模式变化，立即切换
            elif new_cloud_enabled != self.cloud_mode:
                self.cloud_mode = new_cloud_enabled
                if new_cloud_enabled:
                    # 切换到 Cloud 模式
                    self.stop_monitoring()
                    self._start_cloud_mode()
                    QMessageBox.information(self, "设置已保存", "已切换到 Cloud 模式。")
                else:
                    # 切换到本地模式
                    self._stop_cloud_mode()
                    self.start_monitoring()
                    QMessageBox.information(self, "设置已保存", "已切换到本地模式。")
            else:
                QMessageBox.information(self, "设置已保存", "设置已保存。")
        except Exception as e:
            QMessageBox.critical(self, "保存失败", f"保存设置失败: {e}")

    def closeEvent(self, event):
        if self.tray_icon.isVisible():
            self.hide()
            event.ignore()
            self.tray_icon.showMessage("iPhone Duo 库存监控", "程序已最小化到菜单栏，继续后台监控",
                                       QSystemTrayIcon.Information, 2000)
        else:
            event.accept()

    def quit_app(self):
        self.stop_monitoring()
        self._stop_cloud_mode()
        self.tray_icon.hide()
        QApplication.quit()


def main():
    # v1.4.0: 初始化日志到用户数据目录
    from monitor import setup_logging
    from config_loader import load_config
    try:
        config, _, _ = load_config(CONFIG_DIR)
    except Exception:
        config = {}
    setup_logging(config, log_dir=os.path.join(DATA_DIR, "logs"))
    logging.getLogger(__name__).info("GUI 启动，日志目录: %s", os.path.join(DATA_DIR, "logs"))

    app = QApplication(sys.argv)
    app.setApplicationName("iPhoneDuoMonitor")
    app.setQuitOnLastWindowClosed(False)
    window = MainWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
