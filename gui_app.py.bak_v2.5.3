                cell_color = "#2ecc71"
            elif avail is False:
                cell_text = "无货"
                cell_color = "#e74c3c"
            else:
                cell_text = "未知"
                cell_color = "#f39c12"

            self.china_control_table.setItem(row, 0, QTableWidgetItem(store.get("city", "")))
            self.china_control_table.setItem(row, 1, QTableWidgetItem(store.get("name", "")))
            self.china_control_table.setItem(row, 2, QTableWidgetItem(sn))
            item = QTableWidgetItem(cell_text)
            item.setForeground(QColor(cell_color))
            self.china_control_table.setItem(row, 3, item)

