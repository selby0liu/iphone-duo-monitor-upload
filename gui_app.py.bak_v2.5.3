                model = "iPhone 18 Pro Max"
            else:
                model = "iPhone Duo"
            sku_headers.append(f"{model}\n{s['capacity']}\n{s['color']}")
            self._sku_col_map[s["id"]] = i + 3  # 前3列是城市/门店/Store ID
        columns = ["城市", "Apple Store", "Store ID"] + sku_headers + ["最后已知", "更新时间"]
