    def start_monitoring(self):
        if self.monitor_thread and self.monitor_thread.isRunning():
            return
        self.monitor_thread = QThread()
        self.monitor_worker = MonitorWorker(self.config_dir)
        self.monitor_worker.moveToThread(self.monitor_thread)
        self.monitor_thread.started.connect(self.monitor_worker.start)
        self.monitor_worker.status_update.connect(self._on_status_update)
        self.monitor_worker.log_message.connect(self._on_log_message)
        self.monitor_worker.alert_signal.connect(self._on_alert)
        self.monitor_worker.api_record.connect(self._on_api_record)
        self.monitor_thread.start()
        self.status_bar.showMessage("监控运行中...")
        self._append_log("GUI 监控线程已启动")

    def stop_monitoring(self):
        if self.monitor_worker:
            self.monitor_worker.stop()
        if self.monitor_thread:
            self.monitor_thread.quit()
            self.monitor_thread.wait(10000)
            if self.monitor_thread.isRunning():
                self.monitor_thread.terminate()
                self.monitor_thread.wait(3000)
        self.monitor_worker = None
        self.monitor_thread = None
        self.status_bar.showMessage("监控已停止")
        self._append_log("监控已停止")

    # ===== v2.0: Cloud 模式 =====

    def _start_cloud_mode(self):
        """启动 Cloud 模式，从云端读取状态，不启动本地 Monitor"""
        from cloud_client import CloudClient

        server_url = self.cloud_url_edit.text().strip()
        auth_token = self.cloud_token_edit.text().strip()

        if not server_url or not auth_token:
            self.cloud_status_label.setText("Cloud 状态: 未配置服务器地址或 Token")
            self.cloud_status_label.setStyleSheet("color: #e74c3c;")
            self.status_bar.showMessage("Cloud 模式未配置，请在设置中填写服务器地址和 Token")
            # 回退到本地模式
            self.cloud_mode = False
            QTimer.singleShot(1000, self.start_monitoring)
            return

        self.cloud_client = CloudClient(server_url, auth_token, poll_interval=10)
        self.cloud_client.status_callback = self._on_cloud_status_update
        self.cloud_client.start()

        self.cloud_status_label.setText("Cloud 状态: 连接中...")
        self.cloud_status_label.setStyleSheet("color: #f39c12;")
        self.status_bar.showMessage("Cloud 模式运行中（本地 Monitor 已关闭）")
        self._append_log(f"Cloud 模式已启动: {server_url}")

        # 更新顶部面板显示 Cloud 模式
        self.network_label.setText("数据源: Cloud")
        self.pickup_api_label.setText("Pickup API: 等待云端数据...")

    def _stop_cloud_mode(self):
        """停止 Cloud 模式"""
        if self.cloud_client:
            self.cloud_client.stop()
            self.cloud_client = None
        self.cloud_status_label.setText("Cloud 状态: 已停止")
        self.cloud_status_label.setStyleSheet("color: #95a5a6;")

    def _on_cloud_status_update(self, status_data, online, error):
        """Cloud 状态更新回调"""
        if online and status_data:
            self.cloud_status_label.setText("Cloud 状态: 在线 ✓")
            self.cloud_status_label.setStyleSheet("color: #27ae60;")

            # 更新顶部面板
            monitor = status_data.get("monitor", {})
            pickup = status_data.get("pickup", {})
            delivery = status_data.get("delivery", {})

            self.pickup_api_label.setText(
                f"Pickup API: {'正常' if pickup.get('api_available') else '异常'}"
            )
            self.check_count_label.setText(f"累计检查: {monitor.get('check_count', 0)}")

            if monitor.get("last_check"):
                from datetime import datetime as dt
                self.last_success_label.setText(
                    f"最近检查: {dt.fromtimestamp(monitor['last_check']).strftime('%H:%M:%S')}"
                )

            if monitor.get("last_error"):
                self.last_error_label.setText(f"最近错误: {monitor['last_error']}")

            # 检测库存变化并触发本地通知
            inventory = status_data.get("inventory", {})
            self._detect_cloud_inventory_changes(inventory)

            # 更新库存表
            self._update_store_table_from_cloud(inventory)

        else:
            self.cloud_status_label.setText(f"Cloud 状态: 离线 ({error[:30] if error else '未知错误'})")
            self.cloud_status_label.setStyleSheet("color: #e74c3c;")
            self.pickup_api_label.setText("Pickup API: 云端离线，数据暂不可更新")
            # 不显示无货，保持最后已知状态

    def _detect_cloud_inventory_changes(self, inventory):
        """检测云端库存变化，触发 macOS 本地通知和声音"""
        if not inventory:
            return

        # inventory 格式: {"sku_id|store_number": {"available": True/False/None, ...}}
        for key, state in inventory.items():
            if "|" not in key:
                continue
            available = state.get("available")

            # 只在从无货/未知变为有货时触发
            prev = self._cloud_last_inventory.get(key, {}).get("available")
            if available is True and prev is not True:
                # 解析 SKU 和门店
                parts = key.split("|", 1)
                sku_id = parts[0]
                store_number = parts[1]

                # 获取 SKU 名称
                sku_name = sku_id
                for sku in self.all_skus:
                    if sku.get("id") == sku_id or sku.get("part_number") == sku_id:
                        sku_name = sku.get("name", sku_id)
                        break

                # 获取门店名称
                store_name = store_number
                for region_stores in self.stores.values() if isinstance(self.stores, dict) else self.stores:
                    if isinstance(region_stores, list):
                        for s in region_stores:
                            if s.get("store_number") == store_number:
                                store_name = s.get("store_name", store_number)
                                break
                    elif isinstance(region_stores, dict) and region_stores.get("store_number") == store_number:
                        store_name = region_stores.get("store_name", store_number)

                # 触发 macOS 通知
                title = "iPhone Duo 有货！"
                body = f"{sku_name}\n门店: {store_name}\n点击查看详情"
                self._send_macos_notification(title, body)

                # 播放声音
                if self.config.get("notification", {}).get("sound", True):
                    self._play_alert_sound()

                # 自动打开购买页（如果启用）
                if self.config.get("notification", {}).get("auto_open_buy_page", False):
                    self._open_buy_page(sku_id)

                self._append_log(f"[Cloud通知] {sku_name} @ {store_name} 有货！")

        # 更新上次状态
        self._cloud_last_inventory = inventory

    def _send_macos_notification(self, title, body):
        """发送 macOS 系统通知"""
        try:
            import subprocess
            script = f'display notification "{body}" with title "{title}" sound name "Glass"'
            subprocess.run(["osascript", "-e", script], capture_output=True, timeout=5)
        except Exception as e:
            self._append_log(f"[通知失败] {e}")

    def _play_alert_sound(self):
        """播放提示音"""
        try:
            import subprocess
            sound_file = self.config.get("notification", {}).get("sound_file", "/System/Library/Sounds/Glass.aiff")
            subprocess.run(["afplay", sound_file], capture_output=True, timeout=5)
        except Exception:
            pass

    def _open_buy_page(self, sku_id):
        """打开 Apple 官方购买页"""
        try:
            from PySide6.QtGui import QDesktopServices
            from PySide6.QtCore import QUrl
            # 构建 Apple 购买页 URL
            part_number = sku_id
            for sku in self.all_skus:
                if sku.get("id") == sku_id:
                    part_number = sku.get("part_number", sku_id)
                    break
            url = f"https://www.apple.com.cn/shop/buy-iphone/iphone-duo/{part_number}"
            QDesktopServices.openUrl(QUrl(url))
        except Exception as e:
            self._append_log(f"[打开购买页失败] {e}")

    def _update_store_table_from_cloud(self, inventory):
        """从云端库存数据更新表格"""
        if not inventory:
            return
        try:
            # 获取启用的 SKU 列表（用于列映射）
            enabled_skus = get_enabled_skus(self.all_skus)

            for row in range(self.store_table.rowCount()):
                # Store ID 在第3列（index 2）
                store_id_item = self.store_table.item(row, 2)
                if not store_id_item:
                    continue
                store_number = store_id_item.text()

                for col, sku in enumerate(enabled_skus):
                    if col + 3 >= self.store_table.columnCount():
                        break
                    sku_id = sku.get("id", sku.get("part_number", ""))
                    key = f"{sku_id}|{store_number}"
                    state = inventory.get(key, {})
                    available = state.get("available")

                    if available is True:
                        text = "有货"
                        color = QColor("#27ae60")  # 绿色
                    elif available is False:
                        text = "无货"
                        color = QColor("#7f8c8d")  # 灰色
                    else:
                        text = "未知"
                        color = QColor("#f39c12")  # 橙色

                    item = QTableWidgetItem(text)
                    item.setForeground(color)
                    item.setTextAlignment(Qt.AlignCenter)
                    self.store_table.setItem(row, col + 3, item)
        except Exception as e:
            self._append_log(f"[Cloud表格更新失败] {e}")

    def _test_cloud_connection(self):
        """测试 Cloud 连接"""
        from cloud_client import CloudClient

        server_url = self.cloud_url_edit.text().strip()
        auth_token = self.cloud_token_edit.text().strip()

        if not server_url or not auth_token:
            QMessageBox.warning(self, "提示", "请先填写服务器地址和 Token")
            return

        self.cloud_test_btn.setEnabled(False)
        self.cloud_test_btn.setText("测试中...")

        def do_test():
            client = CloudClient(server_url, auth_token)
            success, msg = client.test_connection()
            self.cloud_test_btn.setEnabled(True)
            self.cloud_test_btn.setText("测试 Cloud 连接")
            if success:
                self.cloud_status_label.setText(f"Cloud 状态: {msg}")
                self.cloud_status_label.setStyleSheet("color: #27ae60;")
                QMessageBox.information(self, "连接成功", msg)
            else:
                self.cloud_status_label.setText(f"Cloud 状态: 连接失败 - {msg[:50]}")
                self.cloud_status_label.setStyleSheet("color: #e74c3c;")
                QMessageBox.warning(self, "连接失败", msg)

        from threading import Thread
        Thread(target=do_test, daemon=True).start()

    def _toggle_cloud_token_visibility(self, checked):
        """切换 Cloud Token 显示/隐藏"""
        if checked:
            self.cloud_token_edit.setEchoMode(QLineEdit.Normal)
            self.cloud_token_toggle_btn.setText("隐藏")
        else:
            self.cloud_token_edit.setEchoMode(QLineEdit.Password)
            self.cloud_token_toggle_btn.setText("显示")

    def _on_api_record(self, endpoint, http_status, latency, success, network_session_id=0):
        self.api_history.current_session_id = network_session_id
        self.api_history.record(endpoint, http_status, latency, success, network_session_id)
        if success:
            self.consecutive_success += 1
            self.consecutive_failure = 0
            self.last_success_time = time.time()
        else:
            self.consecutive_failure += 1
            self.consecutive_success = 0
            self.last_error_time = time.time()
            self.last_error_msg = f"HTTP {http_status}"

    def _on_status_update(self, status_data):
        self.current_status = status_data

        pickup_api = status_data.get("pickup_api_available")
        if pickup_api is True:
            self.pickup_api_label.setText("Pickup API: 正常")
            self.pickup_api_label.setStyleSheet("color: #2ecc71;")
            self.pickup_http_label.setText("HTTP: 200")
        elif pickup_api is False:
            self.pickup_api_label.setText("Pickup API: 暂不可用")
            self.pickup_api_label.setStyleSheet("color: #e74c3c;")
            self.pickup_http_label.setText("HTTP: 541")
        else:
            self.pickup_api_label.setText("Pickup API: 检测中...")
            self.pickup_api_label.setStyleSheet("color: #f39c12;")
            self.pickup_http_label.setText("HTTP: -")

        meta = status_data.get("meta", {})
        last_check = meta.get("last_check")
        if last_check:
            self.last_success_label.setText(f"最近成功: {datetime.fromtimestamp(last_check).strftime('%H:%M:%S')}")
        if self.last_error_time:
            self.last_error_label.setText(f"最近错误: {datetime.fromtimestamp(self.last_error_time).strftime('%H:%M:%S')}")
        region_interval = status_data.get('pickup_region_interval', 15)
        stagger = status_data.get('pickup_stagger', 5)
        backoff_dict = status_data.get('pickup_backoff', {})
        max_backoff = max(backoff_dict.values()) if backoff_dict else 0
        if max_backoff > 0:
            self.interval_label.setText(f"区域轮询: {region_interval}秒 | 错峰: {stagger}秒 | 当前退避: {max_backoff}秒")
        else:
            self.interval_label.setText(f"区域轮询: {region_interval}秒 | 错峰: {stagger}秒")
        self.check_count_label.setText(f"累计检查: {meta.get('check_count', 0)}")
        self.consecutive_label.setText(f"连续成功: {self.consecutive_success} | 连续失败: {self.consecutive_failure}")

        # Product Locator 状态（v1.3.0）
        pl_status = status_data.get("product_locator", {})
        if pl_status:
            pl_http = pl_status.get("http_status")
            if pl_http == 200:
                self.product_locator_label.setText(f"Product Locator: 正常 (HTTP {pl_http}, {pl_status.get('products_count', 0)}SKU)")
                self.product_locator_label.setStyleSheet("color: #2ecc71;")
            elif pl_http and pl_http != 200:
                self.product_locator_label.setText(f"Product Locator: 不可用 (HTTP {pl_http})")
                self.product_locator_label.setStyleSheet("color: #e74c3c;")
            else:
                self.product_locator_label.setText("Product Locator: 检测中...")
                self.product_locator_label.setStyleSheet("color: #f39c12;")

        # 诊断结论（v1.3.0）
        pickup_ok = status_data.get("pickup_api_available")
        pl_ok = pl_status.get("http_status") == 200 if pl_status else None
        delivery_ok = status_data.get("delivery_status", {})
        if pickup_ok is False and pl_ok:
            self.diagnostic_label.setText("诊断: Pickup通道异常，商品与官网服务正常")
            self.diagnostic_label.setStyleSheet("color: #f39c12;")
        elif pickup_ok is False and pl_ok is False:
            self.diagnostic_label.setText("诊断: Apple商店连接异常 / 当前网络路径异常")
            self.diagnostic_label.setStyleSheet("color: #e74c3c;")
        elif pickup_ok is True and pl_ok:
            self.diagnostic_label.setText("诊断: Apple库存服务正常")
            self.diagnostic_label.setStyleSheet("color: #2ecc71;")
        else:
            self.diagnostic_label.setText("诊断: 检测中...")

        stats = self.api_history.get_stats(hours=1)
        # 显示当前网络会话成功率和全局成功率（v1.3.0）
        session_stats = self.api_history.get_current_session_stats(hours=1)
        global_stats = self.api_history.get_stats(hours=1)
        if session_stats["total"] > 0:
            self.success_rate_label.setText(f"当前网络成功率: {session_stats['rate_200']:.1f}% | 全局: {global_stats['rate_200']:.1f}%")
        elif global_stats["total"] > 0:
            self.success_rate_label.setText(f"成功率: {global_stats['rate_200']:.1f}%")

        self._update_network_info()
        self._update_store_table(status_data)
        self._update_delivery(status_data)
        self._update_stats_panel()
        self._update_china_control(status_data)
        self._update_australia_control(status_data)
        self._update_market_watch(status_data)

    def _update_network_info(self):
        try:
            import urllib.request
            ip = urllib.request.urlopen("https://api.ipify.org", timeout=3).read().decode()
            self.ip_label.setText(f"IP: {ip}")
            self.network_label.setText("网络: 已连接")
            # 查询 ISP（失败不影响监控）
            try:
                import json
                req = urllib.request.Request(
                    f"http://ip-api.com/json/{ip}?fields=isp,org",
                    headers={"User-Agent": "iPhoneDuoMonitor/1.2.1"})
                resp = urllib.request.urlopen(req, timeout=3)
                data = json.loads(resp.read().decode())
                isp = data.get("isp", "未知")
                self.isp_label.setText(f"ISP: {isp}")
            except:
                self.isp_label.setText("ISP: 未知")
        except:
            self.network_label.setText("网络: 检测失败")
            self.isp_label.setText("ISP: 未知")

    def _update_store_table(self, status_data):
        pickup_status = status_data.get("pickup_status", {})
        enabled_skus = status_data.get("enabled_skus", [])
        pickup_api_ok = status_data.get("pickup_api_available")

        for row in range(self.store_table.rowCount()):
            store_id_item = self.store_table.item(row, 2)
            if not store_id_item:
                continue
            store_number = store_id_item.text()
            store_data = pickup_status.get(store_number, {})

            last_known_text = "无数据"
            for col, sku in enumerate(enabled_skus):
                sku_data = store_data.get("skus", {}).get(sku["id"], {})
                available = sku_data.get("available")
                item = QTableWidgetItem()

                if pickup_api_ok is False:
                    # API 不可用，显示未知，但保留最后已知状态
                    item.setText("未知")
                    item.setBackground(QColor("#f39c12"))
                    item.setForeground(QColor("#ffffff"))
                    last_known = sku_data.get("last_known")
                    if last_known is True:
                        last_known_text = "最后已知: 有货"
                    elif last_known is False:
                        last_known_text = "最后已知: 无货"
                elif available is True:
                    item.setText("有货")
                    item.setBackground(QColor("#2ecc71"))
                    item.setForeground(QColor("#ffffff"))
                    last_known_text = "有货"
                elif available is False:
                    item.setText("无货")
                    item.setBackground(QColor("#ecf0f1"))
                    last_known_text = "无货"
                else:
                    item.setText("未知")
                    item.setBackground(QColor("#f39c12"))
                    item.setForeground(QColor("#ffffff"))

                item.setTextAlignment(Qt.AlignCenter)
                self.store_table.setItem(row, 3 + col, item)

            # 最后已知状态列
            self.store_table.setItem(row, 3 + len(enabled_skus), QTableWidgetItem(last_known_text))

            # 更新时间
            last_checked = None
            for sku in enabled_skus:
                sku_data = store_data.get("skus", {}).get(sku["id"], {})
                if sku_data.get("last_checked"):
                    last_checked = sku_data["last_checked"]
                    break
            if last_checked:
                time_str = datetime.fromtimestamp(last_checked).strftime("%H:%M:%S")
                self.store_table.setItem(row, 4 + len(enabled_skus), QTableWidgetItem(time_str))

    def _update_delivery(self, status_data):
        delivery_status = status_data.get("delivery_status", {})
        has_available = False
        has_unknown = False
        has_coming_soon = False
        all_unavailable = True

        for sku_id, label in self.delivery_labels.items():
            data = delivery_status.get(sku_id, {})
            available = data.get("available")
            detail = data.get("detail", {})
            sku_info = next((s for s in self.all_skus if s["id"] == sku_id), {})
            name = f"{sku_info.get('capacity', '')} {sku_info.get('color', '')}"

            if available is True:
                msg = detail.get("message", "可配送")
                date = detail.get("delivery_date", "")
                label.setText(f"{name}:\n可配送 {date}")
                label.setStyleSheet("color: #2ecc71;")
                has_available = True
                all_unavailable = False
            elif available is False:
                is_coming = detail.get("is_coming_soon")
                if is_coming:
                    label.setText(f"{name}:\n即将发售")
                    label.setStyleSheet("color: #f39c12;")
                    has_coming_soon = True
                else:
                    label.setText(f"{name}:\n暂无")
                    label.setStyleSheet("color: #7f8c8d;")
            else:
                label.setText(f"{name}:\n未知")
                label.setStyleSheet("color: #f39c12;")
                has_unknown = True
                all_unavailable = False

        # 更新顶部配送状态
        if has_available:
            self.delivery_label.setText("配送: 正常")
            self.delivery_label.setStyleSheet("color: #2ecc71;")
        elif has_coming_soon:
            self.delivery_label.setText("配送: 即将发售")
            self.delivery_label.setStyleSheet("color: #f39c12;")
        elif all_unavailable:
            self.delivery_label.setText("配送: 暂不可购买")
            self.delivery_label.setStyleSheet("color: #7f8c8d;")
        elif has_unknown:
            self.delivery_label.setText("配送: 不可用")
            self.delivery_label.setStyleSheet("color: #e74c3c;")

