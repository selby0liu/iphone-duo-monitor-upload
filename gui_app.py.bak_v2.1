class APIHistory:
    """API 请求历史统计（内存中，不记录敏感信息）"""
    def __init__(self, max_size=500):
        self.records = deque(maxlen=max_size)
        self.current_session_id = 0

    def record(self, endpoint, http_status, latency, success, network_session_id=0):
        self.records.append({
            "timestamp": time.time(),
            "endpoint": endpoint,
            "http_status": http_status,
            "latency": latency,
            "success": success,
            "network_session_id": network_session_id
        })

    def get_stats(self, hours=1):
        """获取最近N小时的全局统计"""
        cutoff = time.time() - hours * 3600
        recent = [r for r in self.records if r["timestamp"] > cutoff]
        return self._calc_stats(recent)

    def get_current_session_stats(self, hours=1):
        """获取当前网络会话的统计（v1.3.0）"""
        cutoff = time.time() - hours * 3600
        recent = [r for r in self.records
                  if r["timestamp"] > cutoff and r.get("network_session_id") == self.current_session_id]
        return self._calc_stats(recent)

    def _calc_stats(self, records):
        if not records:
            return {"total": 0, "success": 0, "rate_200": 0, "rate_541": 0, "avg_latency": 0}
        total = len(records)
        success = sum(1 for r in records if r["success"])
        count_200 = sum(1 for r in records if r["http_status"] == 200)
        count_541 = sum(1 for r in records if r["http_status"] == 541)
        avg_latency = sum(r["latency"] for r in records) / total
        return {
            "total": total,
            "success": success,
            "rate_200": count_200 / total * 100,
            "rate_541": count_541 / total * 100,
            "avg_latency": avg_latency
        }


class MonitorWorker(QObject):
    """监控工作线程，运行在 QThread 中"""
    status_update = Signal(dict)
    log_message = Signal(str)
    alert_signal = Signal(list)
    api_record = Signal(str, int, float, bool, int)  # endpoint, http_status, latency, success, network_session_id

    def __init__(self, config_dir=None):
        super().__init__()
        self.config_dir = config_dir or BASE_DIR
        self.monitor = None
        self.running = False
        self.interval = 5
        self.test_mode = False

    def start(self):
        try:
            config_dir = self.config_dir
            if getattr(sys, 'frozen', False):
                import shutil
                user_config_dir = os.path.join(DATA_DIR, "config")
                os.makedirs(user_config_dir, exist_ok=True)
                for fname in ["config.json", "skus.json", "stores.json"]:
                    src = os.path.join(APP_DIR, fname)
                    dst = os.path.join(user_config_dir, fname)
                    if os.path.exists(src) and not os.path.exists(dst):
                        shutil.copy2(src, dst)
                config_dir = user_config_dir

            self.monitor = IPhoneDuoMonitor(config_dir, register_signals=False)
            self.interval = self.monitor.interval

            # v1.5.0: 初始化 Pickup Diagnostics（完全旁路，不影响主 Monitor）
            from pickup_diagnostics import PickupDiagnostics
            self.diagnostics = PickupDiagnostics()
            self.diagnostics.start()

            # 初始化新模块（独立于主 Monitor，__init__不联网）
            from china_control_monitor import ChinaControlMonitor
            from australia_monitor import AustraliaControlMonitor
            from market_watch import MarketWatch
            from product_locator_monitor import ProductLocatorMonitor
            self.china_control = ChinaControlMonitor(
                config={"enabled": True, "interval_seconds": 300},
                stores=self.monitor.stores)
            self.australia_control = AustraliaControlMonitor(
                config={"enabled": True, "interval_seconds": 300})
            self.market_watch = MarketWatch(config={"enabled": False})
            self.product_locator = ProductLocatorMonitor(
                config={"enabled": True, "interval_seconds": 300})

            # 新模块错峰启动（v1.3.1 修复：避免启动时瞬间并发触发限流）
            now = time.time()
            for pc in self.china_control.postcodes:
                self.china_control.next_check[pc] = now + 30  # 30秒后再开始
            self.australia_control.next_check = now + 60  # 60秒后再开始
            self.product_locator.next_check = now + 90  # 90秒后再开始

            # v1.5.1: 网络会话追踪统一由 diagnostics 管理
            self._last_diag_network_check = 0

            self.running = True
            self.log_message.emit(f"监控启动 v{APP_VERSION} | SKU: {len(self.monitor.enabled_skus)} 个 | 门店: {len(self.monitor.target_store_numbers)} 家 | 区域轮询: {self.monitor.pickup_region_interval}秒 错峰: {self.monitor.pickup_stagger_seconds}秒")

            while self.running:
                try:
                    start = time.time()
                    alerts = self.monitor.run_once()
                    duration = time.time() - start

                    # v1.5.0: 记录 App Pickup 审计日志
                    try:
                        pickup_status = "200" if self.monitor.pickup_api_available else "541"
                        self.diagnostics.log_app_pickup_request(
                            status=pickup_status,
                            latency=duration,
                        )
                    except Exception:
                        pass

                    # v1.5.1: diagnostics 网络变化检测（每30秒一次，带缓存）
                    now = time.time()
                    if now - self._last_diag_network_check > 30:
                        self._last_diag_network_check = now
                        try:
                            network_change = self.diagnostics.check_network_change()
                            if network_change:
                                self.log_message.emit(
                                    f"网络切换: {network_change['old_ip']} -> {network_change['new_ip']}, "
                                    f"新 session={network_change['new_session']}")
                                self.monitor.reset_all_backoff()
                                self.monitor.clear_api_session()
                                # 新模块错峰恢复
                                now_t = time.time()
                                for pc in self.china_control.postcodes:
                                    self.china_control.next_check[pc] = now_t + 10
                                self.australia_control.next_check = now_t + 20
                                self.product_locator.next_check = now_t + 30
                        except Exception:
                            pass

                    # 新模块独立检查（失败不影响主 Monitor）
                    try:
                        self.china_control.check_once()
                    except Exception as e:
                        self.log_message.emit(f"China Control 异常（不影响主监控）: {e}")
                    try:
                        self.australia_control.check_once()
                    except Exception as e:
                        self.log_message.emit(f"Australia Control 异常（不影响主监控）: {e}")
                    try:
                        self.product_locator.check()
                    except Exception as e:
                        self.log_message.emit(f"Product Locator 异常（不影响主监控）: {e}")

                    # 记录 API 统计（带网络会话ID，v1.5.1 从 diagnostics 获取）
                    pickup_ok = self.monitor.pickup_api_available
                    try:
                        session_id = int(self.diagnostics.get_current_session().get("session_id", "0"), 16) % 10000
                    except Exception:
                        session_id = 0
                    self.api_record.emit("pickup", 200 if pickup_ok else 541, duration, pickup_ok, session_id)

                    if alerts:
                        self.alert_signal.emit(alerts)

                    status_data = self._collect_status()
                    self.status_update.emit(status_data)

                except Exception as e:
                    self.log_message.emit(f"监控异常: {e}")

                for _ in range(int(self.interval * 10)):
                    if not self.running:
                        break
                    time.sleep(0.1)

        except Exception as e:
            self.log_message.emit(f"监控启动失败: {e}")

    def stop(self):
        self.running = False
        if self.monitor:
            self.monitor.running = False
        # v1.5.0: 停止 diagnostics
        if hasattr(self, 'diagnostics') and self.diagnostics:
            try:
                self.diagnostics.stop()
            except Exception:
                pass

    def _collect_status(self) -> dict:
        m = self.monitor
        if not m:
            return {}

        pickup_status = {}
        for store_number in m.target_store_numbers:
            store_info = m.store_map.get(store_number, {})
            pickup_status[store_number] = {
                "name": store_info.get("name", store_number),
                "city": store_info.get("city", ""),
                "skus": {}
            }
            for sku in m.enabled_skus:
                state = m.state.get_pickup_state(sku["id"], store_number)
                pickup_status[store_number]["skus"][sku["id"]] = {
                    "available": state.get("available"),
                    "last_checked": state.get("last_checked"),
                    "last_known": state.get("available"),  # 最后已知状态
                    "detail": state.get("detail", {})
                }

        delivery_status = {}
        for sku in m.enabled_skus:
            state = m.state.get_delivery_state(sku["id"])
            delivery_status[sku["id"]] = {
                "available": state.get("available"),
                "last_checked": state.get("last_checked"),
                "detail": state.get("detail", {})
            }

        meta = m.state.get_meta()

        # 新模块状态（独立于主 Monitor）
        china_control_status = {}
        australia_status = {}
        market_status = {}
        product_locator_status = {}
        if hasattr(self, 'china_control'):
            china_control_status = self.china_control.get_status()
        if hasattr(self, 'australia_control'):
            australia_status = self.australia_control.get_status()
        if hasattr(self, 'market_watch'):
            market_status = self.market_watch.get_status()
        if hasattr(self, 'product_locator'):
            product_locator_status = {
                "http_status": self.product_locator.http_status,
                "last_success": self.product_locator.last_success,
                "last_error": self.product_locator.last_error,
                "products_count": len(self.product_locator.products),
                "consecutive_failures": self.product_locator.consecutive_failures,
                "backoff_seconds": self.product_locator.backoff_seconds,
                "sku_status": {pn: pl.get("exists", False) for pn, pl in self.product_locator.products.items()},
            }

        return {
            "pickup_api_available": m.pickup_api_available,
            "pickup_status": pickup_status,
            "delivery_status": delivery_status,
            "meta": meta,
            "enabled_skus": [{"id": s["id"], "name": s["name"], "part_number": s["part_number"],
                              "capacity": s["capacity"], "color": s["color"]} for s in m.enabled_skus],
            "interval": self.interval,
            "pickup_region_interval": getattr(m, 'pickup_region_interval', 30),
            "pickup_stagger": getattr(m, 'pickup_stagger_seconds', 10),
            "pickup_backoff": getattr(m, 'pickup_backoff', {}),
            "pickup_next_check": getattr(m, 'pickup_next_check', {}),
            "test_mode": self.test_mode,
            "china_control": china_control_status,
            "australia_control": australia_status,
            "market_watch": market_status,
            "product_locator": product_locator_status,
            # v1.5.1: 从 diagnostics 获取网络信息
            "public_ip": getattr(self.diagnostics, 'get_current_session', lambda: {})().get('public_ip') if hasattr(self, 'diagnostics') else None,
            "network_session_id": getattr(self.diagnostics, 'get_current_session', lambda: {})().get('session_id', '0') if hasattr(self, 'diagnostics') else '0',
        }

    def update_interval(self, seconds):
        self.interval = seconds
        if self.monitor:
            self.monitor.interval = seconds

