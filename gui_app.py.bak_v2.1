    def _update_china_control(self, status_data):
        """更新 China Control 标签页"""
        cc = status_data.get("china_control", {})
        if not cc:
            return

        available = cc.get("available")
        if available is True:
            status_text = "有货"
            color = "#2ecc71"
        elif available is False:
            status_text = "无货"
            color = "#e74c3c"
        else:
            status_text = "未知（API不可用）"
            color = "#f39c12"

        last_success = cc.get("last_success")
        last_success_str = datetime.fromtimestamp(last_success).strftime('%H:%M:%S') if last_success else "-"
        last_error = cc.get("last_error") or "-"
        http_status = cc.get("last_http_status") or "-"

        self.china_status_label.setText(
            f"状态: {status_text} | HTTP: {http_status} | "
            f"最近成功: {last_success_str} | 连续成功: {cc.get('consecutive_success', 0)} | "
            f"连续失败: {cc.get('consecutive_failure', 0)}\n"
            f"最近错误: {last_error}"
        )
        self.china_status_label.setStyleSheet(f"color: {color};")

        # 更新门店表
        stores = cc.get("stores", {})
        target_stores = []
        if hasattr(self, 'monitor_worker') and self.monitor_worker and hasattr(self.monitor_worker, 'monitor'):
            stores_dict = self.monitor_worker.monitor.stores
            if isinstance(stores_dict, dict):
                for region in stores_dict.get("regions", {}).values():
                    target_stores.extend(region.get("stores", []))
        elif hasattr(self, 'stores'):
            target_stores = self.stores

        self.china_control_table.setRowCount(len(target_stores))
        for row, store in enumerate(target_stores):
            sn = store.get("store_number", "")
            store_state = stores.get(sn, {})
            avail = store_state.get("available")
            if avail is True:
                cell_text = "有货"
                cell_color = "#2ecc71"
            elif avail is False:
                cell_text = "无货"
                cell_color = "#e74c3c"
            else:
                cell_text = "未知"
                cell_color = "#f39c12"

            self.china_control_table.setItem(row, 0, QTableWidgetItem(store.get("city", "")))
            self.china_control_table.setItem(row, 1, QTableWidgetItem(store.get("name", "")))
            self.china_control_table.setItem(row, 2, QTableWidgetItem(sn))
            item = QTableWidgetItem(cell_text)
            item.setForeground(QColor(cell_color))
            self.china_control_table.setItem(row, 3, item)

