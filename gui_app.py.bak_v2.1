    def _setup_store_table(self):
        enabled_skus = get_enabled_skus(self.all_skus)
        columns = ["城市", "Apple Store", "Store ID"] + [f"{s['capacity']}\n{s['color']}" for s in enabled_skus] + ["最后已知", "更新时间"]
        self.store_table.setColumnCount(len(columns))
        self.store_table.setHorizontalHeaderLabels(columns)

        store_numbers = get_all_store_numbers(self.stores)
        self.store_table.setRowCount(len(store_numbers))

        for row, sn in enumerate(store_numbers):
            store_info = self.store_map.get(sn, {})
            self.store_table.setItem(row, 0, QTableWidgetItem(store_info.get("city", "")))
            self.store_table.setItem(row, 1, QTableWidgetItem(store_info.get("name", sn)))
            self.store_table.setItem(row, 2, QTableWidgetItem(sn))
            for col in range(len(columns)):
                item = self.store_table.item(row, col)
                if item:
                    item.setTextAlignment(Qt.AlignCenter)

        self.store_table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.store_table.verticalHeader().setVisible(False)
        self.store_table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.store_table.setAlternatingRowColors(True)

