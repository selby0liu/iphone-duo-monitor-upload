#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
状态持久化管理
- 每个 SKU × 每家门店 的到店取货状态
- 每个 SKU 的官网配送状态
- 只在"无货→有货"时报警，持续有货不重复
- 消失后再恢复可再次报警
- 重启后状态正确恢复
"""

import json
import os
import time
import logging
from typing import Dict, Optional

logger = logging.getLogger(__name__)


class StateManager:
    """监控状态持久化"""

    def __init__(self, state_file: str):
        self.state_file = state_file
        self.state = {
            "pickup": {},      # {"sku_id|store_number": {"available": bool, "last_available": ts, "last_checked": ts, "first_detected": ts}}
            "delivery": {},    # {"sku_id": {"available": bool, "last_available": ts, "last_checked": ts, "first_detected": ts}}
            "meta": {
                "created_at": time.time(),
                "last_check": None,
                "check_count": 0,
                "last_error": None,
            }
        }
        self._load()

    def _load(self):
        """从文件加载状态"""
        if os.path.exists(self.state_file):
            try:
                with open(self.state_file, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                    if isinstance(loaded, dict):
                        # 合并，保留新字段
                        if "pickup" in loaded:
                            self.state["pickup"] = loaded["pickup"]
                        if "delivery" in loaded:
                            self.state["delivery"] = loaded["delivery"]
                        if "meta" in loaded:
                            self.state["meta"].update(loaded["meta"])
                        logger.info("状态已从 %s 加载", self.state_file)
            except (json.JSONDecodeError, IOError) as e:
                logger.warning("加载状态文件失败，使用空状态: %s", e)

    def _save(self):
        """保存状态到文件"""
        os.makedirs(os.path.dirname(self.state_file) or ".", exist_ok=True)
        try:
            with open(self.state_file, "w", encoding="utf-8") as f:
                json.dump(self.state, f, ensure_ascii=False, indent=2)
        except IOError as e:
            logger.error("保存状态文件失败: %s", e)

    def _make_key(self, sku_id: str, store_number: str = None) -> str:
        if store_number:
            return f"{sku_id}|{store_number}"
        return sku_id

    def update_pickup(self, sku_id: str, store_number: str,
                      available, detail: dict = None) -> Optional[dict]:
        """
        更新到店取货状态
        available: True(有货) / False(无货) / None(未知/API不可用)
        返回: 如果状态从无货变为有货，返回报警信息；否则返回 None
        """
        key = self._make_key(sku_id, store_number)
        now = time.time()
        prev = self.state["pickup"].get(key, {})
        prev_available = prev.get("available", False)

        entry = {
            "available": available,  # True/False/None
            "last_checked": now,
            "last_available": now if available is True else prev.get("last_available"),
            "first_detected": now if (available is True and prev_available is not True) else prev.get("first_detected"),
            "detail": detail or {},
        }
        self.state["pickup"][key] = entry
        self._save()

        # 状态变化判断：无货/未知→有货 触发报警
        # 未知(None)不触发任何变化，保持上次已知状态
        if available is True and prev_available is not True:
            return {
                "type": "pickup",
                "sku_id": sku_id,
                "store_number": store_number,
                "detail": detail or {},
                "timestamp": now,
            }
        return None

    def update_delivery(self, sku_id: str, available,
                        detail: dict = None) -> Optional[dict]:
        """
        更新官网配送状态
        available: True(有货) / False(无货) / None(未知/API不可用)
        返回: 如果状态从无货变为有货，返回报警信息；否则返回 None
        """
        key = self._make_key(sku_id)
        now = time.time()
        prev = self.state["delivery"].get(key, {})
        prev_available = prev.get("available", False)

        entry = {
            "available": available,  # True/False/None
            "last_checked": now,
            "last_available": now if available is True else prev.get("last_available"),
            "first_detected": now if (available is True and prev_available is not True) else prev.get("first_detected"),
            "detail": detail or {},
        }
        self.state["delivery"][key] = entry
        self._save()

        if available is True and prev_available is not True:
            return {
                "type": "delivery",
                "sku_id": sku_id,
                "detail": detail or {},
                "timestamp": now,
            }
        return None

    def update_meta(self, last_check=None, check_count=None, last_error=None, actual_request_count=None):
        """更新元信息"""
        if last_check is not None:
            self.state["meta"]["last_check"] = last_check
        if check_count is not None:
            self.state["meta"]["check_count"] = check_count
        if last_error is not None:
            self.state["meta"]["last_error"] = last_error
        if actual_request_count is not None:
            self.state["meta"]["actual_request_count"] = actual_request_count
        self._save()

    def get_pickup_state(self, sku_id: str, store_number: str) -> dict:
        """获取指定 SKU × 门店的状态"""
        return self.state["pickup"].get(self._make_key(sku_id, store_number), {})

    def get_delivery_state(self, sku_id: str) -> dict:
        """获取指定 SKU 的配送状态"""
        return self.state["delivery"].get(self._make_key(sku_id), {})

    def get_all_pickup_states(self) -> Dict[str, dict]:
        """获取所有到店取货状态"""
        return self.state["pickup"]

    def get_all_delivery_states(self) -> Dict[str, dict]:
        """获取所有配送状态"""
        return self.state["delivery"]

    def get_meta(self) -> dict:
        """获取元信息"""
        return self.state["meta"]

    def reset(self):
        """重置所有状态（测试用）"""
        self.state = {
            "pickup": {},
            "delivery": {},
            "meta": {
                "created_at": time.time(),
                "last_check": None,
                "check_count": 0,
                "last_error": None,
            }
        }
        self._save()
